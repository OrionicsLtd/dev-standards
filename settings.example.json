{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$HOME/.claude/hooks/run_devgate.py\" session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$HOME/.claude/hooks/run_devgate.py\" stop",
            "timeout": 600
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "diff-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$HOME/.claude/hooks/run_devgate.py\" subagent-stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
